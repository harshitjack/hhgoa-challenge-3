{
  "name": "hhgoa-face-blockchain-backend",
  "version": "1.0.0",
  "description": "HH Goa 2026 Shortlisting Task 3: Face Identification & Blockchain Verification Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:contract": "hardhat test",
    "compile:contract": "hardhat compile",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy"
  },
  "keywords": [
    "face-verification",
    "blockchain",
    "polygon-amoy",
    "insightface",
    "google-lens"
  ],
  "author": "HH Goa 2026 Candidate",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "form-data": "^4.0.2",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.35.4",
    "uuid": "^11.0.5",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.18",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "contract.test.js"
    ],
    "verbose": true
  }
}
