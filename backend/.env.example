# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hh-goafacereco

# SerpAPI Google Lens API Key
SERPAPI_KEY=your_serpapi_key_here

# Python InsightFace Microservice URL
FACE_SERVICE_URL=http://127.0.0.1:5001

# Face Similarity Verification Threshold (Model/Dataset specific; default 0.70)
FACE_MATCH_THRESHOLD=0.70

# Polygon Amoy Testnet Configuration
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
PRIVATE_KEY=your_polygon_amoy_private_key_without_0x_or_with_0x
CONTRACT_ADDRESS=your_deployed_verification_registry_contract_address
